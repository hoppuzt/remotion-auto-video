{
  "name": "remotion-auto-video",
  "version": "1.0.0",
  "private": true,
  "description": "Automated motion video rendering cloud using Claude and Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "voiceover": "node scripts/generate-voiceover.mjs input.json resolved.json",
    "render": "npm run voiceover && remotion render src/index.ts my-video out/video.mp4 --props=resolved.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/three": "4.0.541",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0"
  }
}
